PORT=8081

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Live telemetry — the ALREADY-DEPLOYED Automotive-Insights-Output ingress URL
# (same one the dashboard's VITE_AUTO_API_URL points at). This app only reads
# from it via REST (GET /api/assets/:vin) — no Kafka topics involved.
TELEMETRY_API_URL=https://your-automotive-insights-output-ingress-url

# L3 escalation email (SMTP). For the demo, point this at your own inbox;
# swap to the real Bosch/RBIN recipient once provided.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ESCALATION_FROM=
ESCALATION_TO=

# When true, skips real Anthropic/SMTP calls and returns canned responses —
# for local wiring tests only. Must be false/unset in any real deployment.
MOCK_MODE=false

CORS_ORIGIN=*
